MEDIAINDEX_OPENAI_API_KEY=
MEDIAINDEX_GEMINI_API_KEY=
MEDIAINDEX_FFMPEG_PATH=C:\\path\\to\\ffmpeg.exe
MEDIAINDEX_AI_BASE_URL=
MEDIAINDEX_AI_MODEL=
MEDIAINDEX_AI_EMBEDDING_MODEL=
MEDIAINDEX_OPENAI_BASE_URL=
MEDIAINDEX_GEMINI_BASE_URL=
MEDIAINDEX_LOCAL_BASE_URL=http://127.0.0.1:11434
MEDIAINDEX_AI_SAMPLE_SECONDS=5
MEDIAINDEX_AI_MAX_FRAMES=120
