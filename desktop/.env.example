MEDIAINDEX_AI_MODEL=gpt-4.1-mini
MEDIAINDEX_AI_EMBEDDING_MODEL=text-embedding-3-small
MEDIAINDEX_AI_SAMPLE_SECONDS=5
MEDIAINDEX_AI_MAX_FRAMES=120
